generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String    @id @default(cuid())
  username           String    @unique
  displayName        String
  email              String    @unique
  passwordHash       String
  type               String    // "player" | "fan"
  ageGroup           String?   // e.g. "U16" — player only
  league             String?   // tier: "Premier" | "Major" | "Major 1" — player only
  club               String?   // player only
  fanClubs           String[]  @default([]) // fan only
  verificationStatus String    @default("pending_review") // pending_review | verified | suspended
  nameMatchesEmail   Boolean?
  trust              Int       @default(0)
  isAdmin            Boolean   @default(false)
  lastActiveAt       DateTime?
  createdAt          DateTime  @default(now())

  playerId String?  // links this account to its Player identity — set at
  player   Player?  @relation(fields: [playerId], references: [id]) // signup via the same name-search/create flow goals use

  reports  Report[]
  sessions Session[]
}

model Session {
  token     String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Referee {
  id        String   @id @default(cuid())
  name      String   @unique
  trust     Int      @default(10)
  sourceUrl String?  // KDUL profile URL, if the scraper found one
  createdAt DateTime @default(now())
}

model Match {
  id                    String    @id @default(cuid())
  league                String    // age group, e.g. "U16"
  tier                  String    // division, e.g. "Premier" | "Major" | "Major 1"
  home                  String
  away                  String
  date                  DateTime?
  refName               String?
  venue                 String?

  // Official result, as scraped from KDUL's site (or set manually by an admin)
  officialHome          Int?
  officialAway          Int?
  officialHomeScorers   String?
  officialAwayScorers   String?
  officialSource        String?   // "kdul-scrape" | "manual"

  // Locked result, written once by the settlement cron 24h after `date`
  settled               Boolean   @default(false)
  settledHome           Int?
  settledAway           Int?
  settledHomeScorers    String?
  settledAwayScorers    String?
  settledMotm           String?
  settledYellow         String?
  settledRed            String?
  settledAt             DateTime?

  kdulSourceId          String?   @unique // dedupe key from the scraper
  createdAt             DateTime  @default(now())

  reports Report[]

  @@index([league, tier])
}

model Report {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  homeScore    Int?
  awayScore    Int?
  homeScorers  String?  // auto-built summary text ("J. Murphy x2, L. Kelly") — kept for the
  awayScorers  String?  // existing settlement algorithm; the real data now lives in Goal rows
  motm         String?
  yellowCards  String?
  redCards     String?
  createdAt    DateTime @default(now())

  goals Goal[]

  @@unique([matchId, accountId]) // DB-level enforcement of "one report per account per match"
}

model ClubInfo {
  club      String    @id
  grounds   String?
  updatedBy String?
  updatedAt DateTime?
}

model TeamInfo {
  key       String    @id // "club|league|tier"
  notes     String?
  updatedBy String?
  updatedAt DateTime?
}

model Article {
  id        String   @id @default(cuid())
  category  String
  headline  String
  teaser    String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/* A player on a specific club/age-group/tier roster. Built organically —
   the first reporter to mention someone creates an unconfirmed entry;
   once a second, independent reporter also picks that same player
   (rather than typing a new name), it flips to confirmed. Unconfirmed
   players count at reduced weight in settlement (see lib/algorithm.js)
   so one person inventing a name can't swing the result on their own. */
model Player {
  id        String   @id @default(cuid())
  name      String
  club      String
  ageGroup  String
  tier      String
  confirmed Boolean  @default(false)
  createdBy String?  // accountId of whoever first added them
  createdAt DateTime @default(now())

  goals    Goal[]
  accounts Account[] // accounts whose owner is this player (normally one, but not enforced)

  @@index([club, ageGroup, tier])
}

model Goal {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  side       String   // "home" | "away"
  playerId   String?
  player     Player?  @relation(fields: [playerId], references: [id])
  playerName String   // denormalized so a goal still displays even if the player row is later deleted
  minute     Int?
  half       String?  // "1st" | "2nd"
  createdAt  DateTime @default(now())
}
